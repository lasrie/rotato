    garten:pflanzt <https://example.org/garten-planer/pflanzen/#JungferImGrunen>;
    garten:monatPflanzung "2025-05"^^xsd:gYearMonth;
    garten:monatErnte "2025-10"^^xsd:gYearMonth.
_:n3-120 a time:TemporalEntity;
