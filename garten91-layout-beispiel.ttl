<https://example.org/garten-planer/data/garten91/layout/#pfl-schnittlauch> a garten:Pflanzung;
    dcterms:title "Schnittlauch im unteren Reihenabschnitt";
    garten:aufBeet <https://example.org/garten-planer/extract/beetplan-2025/#zone-left-vertical>;
    garten:inAbschnitt <https://example.org/garten-planer/data/garten91/layout/#row1-seg2>;
    garten:pflanzt <https://example.org/garten-planer/pflanzen/#Schnittlauch>;
    garten:monatPflanzung "2025-05"^^xsd:gYearMonth;
    garten:monatErnte "2025-10"^^xsd:gYearMonth.
