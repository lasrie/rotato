@prefix garten: <https://example.org/garten-planer/ontology#>.
@prefix plan: <https://example.org/garten-planer/plan#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

<https://example.org/garten-planer/data/garten91/#garten91> a garten:Kleingarten;
    dcterms:title "Kleingarten Garten 91";
    dcterms:relation <https://example.org/garten-planer/extract/beetplan-2025/#dataset>;
    rdfs:comment "Strukturelle Verknüpfung des aus der PowerPoint extrahierten Beetplans 2025 mit dem Garten-Modell. Einige Beet-Metadaten (Fläche, Sonnenlage, Bodentyp) sind noch nicht erfasst."@de;
    garten:hatFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:hatBeet <https://example.org/garten-planer/extract/beetplan-2025/#zone-left-vertical>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-top-center-small>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-center-upper>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-center-lower>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-berry-bed>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-right-vertical-upper>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-right-vertical-lower>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-bottom-right-small>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-bottom-center-small>, <https://example.org/garten-planer/extract/beetplan-2025/#zone-potato-bags>.
<https://example.org/garten-planer/data/garten91/#fruchtfolge91> a garten:Fruchtfolge;
    dcterms:title "Fruchtfolge Garten 91 (vorläufig)";
    rdfs:comment "Vorläufige Fruchtfolge-Ressource zur Verknüpfung des Gartenplans. Start-Beet und Rotationsdauer sind noch nicht modelliert."@de.
<https://example.org/garten-planer/extract/beetplan-2025/#zone-left-vertical> a garten:Beet;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/extract/beetplan-2025/#zone-top-center-small> a garten:Beet;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
