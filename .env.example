# Garten-Planer: Solid-Pod-Konfiguration (ADR-0001, ADR-0005)
# Diese Datei nach .env kopieren und die Werte eintragen:
#   cp .env.example .env && $EDITOR .env
#
# Client-Credentials erzeugen (einmalig, im Browser):
#   1. https://solidcommunity.net → Login
#   2. https://solidcommunity.net/account/ → Abschnitt "Client credentials"
#      → Token erstellen (Name z. B. "garten-planer-sync")
#   3. ID + Secret hier eintragen (Secret wird nur einmal angezeigt!)

POD_BASE=https://lasse.solidcommunity.net/garten/
SOLID_IDP=https://solidcommunity.net
SOLID_CLIENT_ID=HIER_ID_EINTRAGEN
SOLID_CLIENT_SECRET=HIER_SECRET_EINTRAGEN
