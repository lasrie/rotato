# Planungs-Puffer für Garten 91
#
# Neue Pflanzungen, die über den Viewer (Phase B) angelegt werden, landen
# zunächst in dieser Datei. Sie werden sofort validiert und angezeigt.
#
# Verknüpfung zum Rest:
# - Beete:    https://example.org/garten-planer/data/garten91/real/#<slug>
# - Pflanzen: https://example.org/garten-planer/pflanzen/#<Slug>
# - Vorlage: siehe server.py → Vorlagen-Beispiel im Viewer-Formular

@prefix garten:  <https://example.org/garten-planer/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@base <https://example.org/garten-planer/data/garten91/planungen-neu/> .


<https://example.org/garten-planer/data/garten91/planungen-neu/#pneu-2026-101> a garten:Pflanzung ;
    rdfs:label "Basilikum 2026 (neu geplant)"@de ;
    garten:aufBeet <https://example.org/garten-planer/data/garten91/real/#tomatenbeet> ;
    garten:pflanzt <https://example.org/garten-planer/pflanzen/#Basilikum> ;
    garten:monatPflanzung "2026-02"^^xsd:gYearMonth ;
    garten:monatErnte "2026-10"^^xsd:gYearMonth ;
    time:hasTemporalExtent [ a time:TemporalEntity ;
        time:hasTRS <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian> ;
        time:hasBeginning [ time:inXSDgYearMonth "2026-02"^^xsd:gYearMonth ] ] .
