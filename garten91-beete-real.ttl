@prefix garten: <https://example.org/garten-planer/ontology#>.
@prefix gv: <https://example.org/garten-planer/vokabular#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.org/garten-planer/data/garten91/real/#tomatenbeet> a garten:Beet;
    dcterms:title "Tomatenbeet";
    rdfs:comment "Langes Beet entlang der oberen Gartenseite. Eine durchgehende Tomatenreihe; die Zwischenbepflanzung (Jungfer im Grünen, Basilikum) steht versetzt dazwischen und bildet eine 'halbe Reihe'. Maße geschätzt."@de;
    garten:flaeche 12.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:beetAusrichtung gv:ostWest;
    garten:hatReihe <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-tomate>, <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-zwischen>.
<https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-tomate> a garten:Reihe;
    dcterms:title "Tomatenbeet – Tomatenreihe";
    garten:reiheInBeet <https://example.org/garten-planer/data/garten91/real/#tomatenbeet>;
    garten:reihenNummer 1;
    garten:reihenAusrichtung gv:ostWest;
    garten:nutzlaenge 10.0;
    garten:hatAbschnitt <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-tomate-gesamt>.
<https://example.org/garten-planer/data/garten91/real/#tomatenbeet-tomate-gesamt> a garten:ReihenAbschnitt;
    dcterms:title "Tomatenreihe – Gesamtlänge";
    garten:abschnittInReihe <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-tomate>;
    garten:abschnittStart 0.0;
    garten:abschnittEnde 10.0.
<https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-zwischen> a garten:Reihe;
    dcterms:title "Tomatenbeet – Zwischenbepflanzung (halbe Reihe)";
    rdfs:comment "Keine eigene durchgehende Reihe: Jungfer im Grünen und Basilikum stehen versetzt zwischen den Tomaten. Als eigene 'halbe Reihe' modelliert, weil sie räumlich zwischen den Tomatenpflanzen liegt."@de;
    garten:reiheInBeet <https://example.org/garten-planer/data/garten91/real/#tomatenbeet>;
    garten:reihenNummer 2;
    garten:reihenAusrichtung gv:ostWest;
    garten:nutzlaenge 10.0;
    garten:hatAbschnitt <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-zwischen-gesamt>.
<https://example.org/garten-planer/data/garten91/real/#tomatenbeet-zwischen-gesamt> a garten:ReihenAbschnitt;
    dcterms:title "Zwischenbepflanzung – Gesamtlänge";
    garten:abschnittInReihe <https://example.org/garten-planer/data/garten91/real/#tomatenbeet-reihe-zwischen>;
    garten:abschnittStart 0.0;
    garten:abschnittEnde 10.0.
<https://example.org/garten-planer/data/garten91/real/#erdbeer-knoblauch-beet> a garten:Beet;
    dcterms:title "Erdbeer-Knoblauch-Beet";
    rdfs:comment "Kleines quadratisches Beet mit Mischnutzung: Erdbeeren und Knoblauch in einem Beet. Maße geschätzt."@de;
    garten:flaeche 2.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/data/garten91/real/#beetkoerper-nord> a garten:Beet;
    dcterms:title "Beetkörper Nord-Hälfte";
    rdfs:comment "Nördliche Hälfte des großen Beetkörpers oben rechts, getrennt von der Südhälfte durch einen Hackschnitzelweg. Entspricht dem 'oberen Mittelbeet' des Pflanzplans. Maße geschätzt."@de;
    garten:flaeche 12.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:beetAusrichtung gv:ostWest.
<https://example.org/garten-planer/data/garten91/real/#beetkoerper-sued> a garten:Beet;
    dcterms:title "Beetkörper Süd-Hälfte";
    rdfs:comment "Südliche Hälfte des großen Beetkörpers oben rechts. Entspricht dem 'unteren Mittelbeet' des Pflanzplans. Maße geschätzt."@de;
    garten:flaeche 12.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:beetAusrichtung gv:ostWest.
<https://example.org/garten-planer/data/garten91/real/#hackschnitzelweg-beetkoerper> a garten:Beet;
    dcterms:title "Hackschnitzelweg im Beetkörper";
    rdfs:comment "Kein Anbauflächen-Beet: unterteilt den großen Beetkörper in Nord- und Süd-Hälfte. Nur zur Dokumentation der Struktur."@de;
    garten:flaeche 1.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/data/garten91/real/#kartoffelbeet> a garten:Beet;
    dcterms:title "Kartoffelbeet";
    rdfs:comment "Langes Beet entlang der rechten Gartenseite. Eigenständiges Objekt, getrennt vom daneben liegenden Jungpflanzen-Anzuchtkasten. Maße geschätzt."@de;
    garten:flaeche 6.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:beetAusrichtung gv:nordSued.
<https://example.org/garten-planer/data/garten91/real/#jungpflanzen-anzuchtkasten> a garten:Beet;
    dcterms:title "Jungpflanzen-Anzuchtkasten";
    rdfs:comment "Eigenständiger Anzuchtkasten neben dem Kartoffelbeet. Im Pflanzplan 2025 bisher noch nicht erfasst. Maße geschätzt."@de;
    garten:flaeche 1.5;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/data/garten91/real/#physalis-hochbeet> a garten:Beet;
    dcterms:title "Physalis-Hochbeet";
    rdfs:comment "Kleines Hochbeet unten mittig im Garten. Maße geschätzt."@de;
    garten:flaeche 1.5;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/data/garten91/real/#zwiebel-kohlrabi-hochbeet> a garten:Beet;
    dcterms:title "Zwiebel-Kohlrabi-Hochbeet";
    rdfs:comment "Hochbeet neben dem unteren Teil des Beerenbeets. Entspricht den Zwiebeln/Kohlrabi aus dem Pflanzplan. Maße geschätzt."@de;
    garten:flaeche 1.5;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>.
<https://example.org/garten-planer/data/garten91/real/#beerenbeet> a garten:Beet;
    dcterms:title "Beerenbeet";
    rdfs:comment "Langes Beet unten im Garten, in mehrere Abschnitte entlang der Länge unterteilt. Bepflanzung laut Pflanzplan: Erdbeeren, Himbeeren, Jostabeere, Johannisbeere, Stachelbeere, Rosmarin. Abschnitte werden in einem Folgeschritt modelliert. Maße geschätzt."@de;
    garten:flaeche 15.0;
    garten:sonnenlage gv:sonnig;
    garten:bodentyp gv:humos;
    garten:inFruchtfolge <https://example.org/garten-planer/data/garten91/#fruchtfolge91>;
    garten:beetAusrichtung gv:ostWest.
<https://example.org/garten-planer/data/garten91/#garten91> garten:hatBeet <https://example.org/garten-planer/data/garten91/real/#tomatenbeet>, <https://example.org/garten-planer/data/garten91/real/#erdbeer-knoblauch-beet>, <https://example.org/garten-planer/data/garten91/real/#beetkoerper-nord>, <https://example.org/garten-planer/data/garten91/real/#beetkoerper-sued>, <https://example.org/garten-planer/data/garten91/real/#hackschnitzelweg-beetkoerper>, <https://example.org/garten-planer/data/garten91/real/#kartoffelbeet>, <https://example.org/garten-planer/data/garten91/real/#jungpflanzen-anzuchtkasten>, <https://example.org/garten-planer/data/garten91/real/#physalis-hochbeet>, <https://example.org/garten-planer/data/garten91/real/#zwiebel-kohlrabi-hochbeet>, <https://example.org/garten-planer/data/garten91/real/#beerenbeet>.
