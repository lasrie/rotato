## Query
PREFIX garten:  <https://example.org/garten-planer/ontology#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX time:    <http://www.w3.org/2006/time#>

SELECT ?jahr ?beet ?beetTitel ?familie ?familieLabel (COUNT(?pflanzung) AS ?anzahl)
WHERE {
  ?pflanzung a garten:Pflanzung ;
             garten:pflanzt ?pflanze ;
             time:hasTemporalExtent ?te .
  ?te time:hasBeginning ?beginn .
  ?beginn time:inXSDgYear ?jahr .

  OPTIONAL { ?pflanzung garten:aufBeet ?beet . OPTIONAL { ?beet dcterms:title ?beetTitel } }
  OPTIONAL { ?pflanze garten:fruchtFamilie ?familie . OPTIONAL { ?familie skos:prefLabel ?familieLabel } }

  # nur Gemüse (mehnjährig = false), Beeren/Rhabarber/Rosmarin raus
  ?pflanze garten:mehrjaehrig false .
}
GROUP BY ?jahr ?beet ?beetTitel ?familie ?familieLabel
ORDER BY ?jahr ?beetTitel ?familieLabel
LIMIT 500

