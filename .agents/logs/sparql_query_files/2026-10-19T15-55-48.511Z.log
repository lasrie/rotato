## Query
PREFIX garten:  <https://example.org/garten-planer/ontology#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?jahr ?beetTitel ?familieLabel (COUNT(DISTINCT ?pflanzung) AS ?anzahl)
WHERE {
  ?pflanzung a garten:Pflanzung ;
             garten:pflanzt ?pflanze ;
             time:hasTemporalExtent ?te ;
             garten:aufBeet ?beet .
  ?beet dcterms:title ?beetTitel .
  ?te time:hasBeginning ?beginn .
  ?beginn time:inXSDgYearMonth ?ym .
  BIND(SUBSTR(STR(?ym), 1, 4) AS ?jahr)
  ?pflanze garten:fruchtFamilie ?familie ;
           garten:mehrjaehrig false .
  OPTIONAL { ?familie skos:prefLabel ?familieLabel }
}
GROUP BY ?jahr ?beetTitel ?familieLabel
ORDER BY ?jahr ?beetTitel ?familieLabel
LIMIT 500

