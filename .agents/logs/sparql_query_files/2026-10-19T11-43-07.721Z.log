## Query
PREFIX garten:  <https://example.org/garten-planer/ontology#>
PREFIX plan:    <https://example.org/garten-planer/plan#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT ?zone ?zoneTitle ?x ?y ?width ?height ?belegung ?plant ?plantLabel ?displayName ?fromMonth ?toMonth ?confidence ?family ?familyLabel
WHERE {
  <https://example.org/garten-planer/data/garten91/#garten91> garten:hatBeet ?zone .
  ?zone a garten:Beet ;
        dcterms:title ?zoneTitle .
  OPTIONAL { ?zone plan:x ?x ; plan:y ?y ; plan:width ?width ; plan:height ?height . }
  OPTIONAL {
    ?belegung a plan:Belegung ;
              plan:inZone ?zone ;
              plan:confidence ?confidence .
    OPTIONAL { ?belegung garten:pflanzt ?plant .
               OPTIONAL { ?plant skos:prefLabel ?plantLabel }
               OPTIONAL { ?plant garten:fruchtFamilie ?family .
                          OPTIONAL { ?family skos:prefLabel ?familyLabel } }
    }
    OPTIONAL { ?belegung plan:displayName ?displayName }
    OPTIONAL { ?belegung plan:fromMonth ?fromMonth }
    OPTIONAL { ?belegung plan:toMonth ?toMonth }
  }
}
ORDER BY ?zoneTitle ?fromMonth ?toMonth ?plantLabel ?displayName
LIMIT 500

